# ==============================================================================
# PRODUCTION SPORTSBOOK PLATFORM CONFIGURATION
# ==============================================================================

# --- APPLICATION ENVIRONMENT ---
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://your-sportsbook-domain.com"
NEXT_PUBLIC_APP_NAME="CrownBet Sportsbook"

# --- REAL-MONEY MODE SWITCH ---
# Set to 'true' to enable real-money deposits, withdrawals, and authoritative settlement.
# Set to 'false' for demo sandbox mode with virtual currency.
REAL_MONEY_ENABLED=false

# --- POSTGRESQL & FINANCIAL LEDGER (Row-Level Locking Enabled) ---
DATABASE_URL="postgresql://db_user:db_password@db_host:5432/sportsbook_prod?schema=public&sslmode=require"

# --- REDIS CACHING & FAST IN-PLAY ODDS RATE LIMITING ---
REDIS_URL="redis://default:redis_password@redis_host:6379"

# --- AUTHENTICATION & SECURITY ---
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET="generate-a-strong-64-char-random-secret-key-for-session-tokens"
CSRF_SECRET="generate-a-strong-64-char-random-secret-key-for-csrf-protection"

# --- THE ODDS API v4 (Sports Odds & Fixture Feed) ---
# Obtain from https://the-odds-api.com
ODDS_API_KEY=""

# --- B2B OFFICIAL SETTLEMENT WEBHOOK (Sportradar / Betradar / Custom Feed) ---
SETTLEMENT_WEBHOOK_SECRET="generate-a-strong-secret-token-for-settlement-webhook"

# --- PAYMENT GATEWAY CONFIGURATION ---
# Supported providers: 'telebirr', 'chapa', 'mock'
PAYMENT_PROVIDER="telebirr"

# 1. Telebirr Production Merchant Credentials (Ethio Telecom)
TELEBIRR_APP_ID="your_telebirr_app_id"
TELEBIRR_APP_KEY="your_telebirr_app_key"
TELEBIRR_SHORT_CODE="your_telebirr_shortcode"
TELEBIRR_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
TELEBIRR_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
TELEBIRR_NOTIFY_URL="https://your-sportsbook-domain.com/api/payments/webhook/telebirr"
TELEBIRR_RETURN_URL="https://your-sportsbook-domain.com/account/wallet"
TELEBIRR_BASE_URL="https://app.ethiomobilemoney.et:2121/openapi/so/payment"

# 2. Chapa Gateway Credentials (Card / CBE Birr / Telebirr Aggregator)
CHAPA_SECRET_KEY="CHASECK_LIVE-xxxxxxxxxxxxxxxxxxxxxxxx"
CHAPA_PUBLIC_KEY="CHAPUBK_LIVE-xxxxxxxxxxxxxxxxxxxxxxxx"
CHAPA_WEBHOOK_SECRET="your_chapa_webhook_secret_hash"
CHAPA_CALLBACK_URL="https://your-sportsbook-domain.com/api/payments/webhook/chapa"
CHAPA_RETURN_URL="https://your-sportsbook-domain.com/account/wallet"

# --- AUTOMATED KYC & FRAUD PREVENTION (Sumsub / Veriff) ---
KYC_PROVIDER="automated"
KYC_WEBHOOK_SECRET="your_kyc_provider_webhook_secret"

# --- JURISDICTION & GEOLOCATION RESTRICTIONS ---
# Comma-separated ISO-2 country codes allowed to place bets
ALLOWED_COUNTRIES="ET"

# --- RISK MANAGEMENT & LIABILITY CAPS (in ETB) ---
MAX_SINGLE_STAKE="25000.00"
MAX_TICKET_PAYOUT="250000.00"
MAX_EVENT_LIABILITY="500000.00"
