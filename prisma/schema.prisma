// Sportsbook prototype schema — DEMO MODE architecture.
// Real-money mode requires licensed payment/KYC/settlement providers wired
// into the abstractions in /services before RealMoney wallets are enabled.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  USER
  ADMIN
  RISK
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  SELF_EXCLUDED
  RESTRICTED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum WalletMode {
  DEMO
  REAL
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_WIN
  BET_REFUND
  BET_VOID
  BONUS
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum BetType {
  SINGLE
  MULTIPLE
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID
  CANCELLED
  REJECTED
}

enum SelectionStatus {
  PENDING
  WON
  LOST
  VOID
}

enum EventStatus {
  UPCOMING
  LIVE
  FINISHED
  CANCELLED
  POSTPONED
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  EXPIRED
  DISABLED
}

// ---------- Core ----------

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  dateOfBirth       DateTime
  country           String
  role              UserRole  @default(USER)
  status            UserStatus @default(ACTIVE)
  kycStatus         KycStatus @default(NOT_STARTED)
  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  wallets                  Wallet[]
  sessions                  Session[]
  bets                      Bet[]
  withdrawals               Withdrawal[]
  paymentTransactions        PaymentTransaction[]
  notifications              Notification[]
  auditLogs                  AuditLog[]           @relation("ActorAuditLogs")
  responsibleGamblingSetting ResponsibleGamblingSetting?
  favorites                  Favorite[]

  @@index([email])
  @@index([status])
}

// Server-side session store backing the HTTP-only session cookie.
// Sessions are looked up on every authenticated request — no JWT trust,
// so a session can be revoked immediately (logout, suspension) rather than
// waiting for token expiry.
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
}

model Wallet {
  id               String     @id @default(cuid())
  userId           String
  mode             WalletMode @default(DEMO)
  currency         String     @default("ETB")
  availableBalance  Decimal    @default(0) @db.Decimal(18, 2)
  lockedBalance     Decimal    @default(0) @db.Decimal(18, 2)
  totalDeposited    Decimal    @default(0) @db.Decimal(18, 2)
  totalWithdrawn    Decimal    @default(0) @db.Decimal(18, 2)
  totalWinnings     Decimal    @default(0) @db.Decimal(18, 2)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  @@unique([userId, mode, currency])
  @@index([userId])
}

// The append-only ledger. Wallet balances are derived/maintained from this;
// never mutate Wallet.availableBalance without writing a corresponding row here
// inside the same DB transaction.
model WalletTransaction {
  id            String                @id @default(cuid())
  walletId      String
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(18, 2)
  currency      String
  status        TransactionStatus     @default(PENDING)
  reference     String                @unique
  provider      String?
  idempotencyKey String               @unique
  metadata      Json?
  createdAt     DateTime              @default(now())
  completedAt   DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id])
  bet    Bet?   @relation(fields: [betId], references: [id])
  betId  String?

  @@index([walletId])
  @@index([type])
  @@index([status])
}

// ---------- Odds / Events (normalized from The Odds API) ----------

model Sport {
  id        String  @id @default(cuid())
  key       String  @unique // e.g. "soccer_epl"
  title     String
  group     String
  active    Boolean @default(true)

  events Event[]
}

model Event {
  id           String      @id @default(cuid())
  externalId   String      @unique // The Odds API event id
  sportId      String
  sportKey     String
  sportTitle   String
  league       String?
  homeTeam     String
  awayTeam     String
  commenceTime DateTime
  status       EventStatus @default(UPCOMING)
  isLive       Boolean     @default(false)
  lastUpdated  DateTime    @default(now())

  sport      Sport        @relation(fields: [sportId], references: [id])
  markets    Market[]
  betSelections BetSelection[]
  favorites  Favorite[]

  @@index([sportKey])
  @@index([commenceTime])
  @@index([status])
}

model Bookmaker {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  region      String?
  lastUpdated DateTime @default(now())

  markets Market[]
}

model Market {
  id            String   @id @default(cuid())
  key           String // h2h, spreads, totals, etc.
  name          String
  eventId       String
  bookmakerId   String
  bookmakerKey  String
  lastUpdated   DateTime @default(now())

  event     Event      @relation(fields: [eventId], references: [id])
  bookmaker Bookmaker  @relation(fields: [bookmakerId], references: [id])
  outcomes  Outcome[]

  @@unique([eventId, bookmakerId, key])
  @@index([eventId])
}

model Outcome {
  id          String   @id @default(cuid())
  marketId    String
  name        String
  price       Decimal  @db.Decimal(10, 3)
  point       Decimal? @db.Decimal(10, 2)
  lastUpdated DateTime @default(now())

  market         Market          @relation(fields: [marketId], references: [id])
  betSelections  BetSelection[]
  snapshots      OddsSnapshot[]

  @@index([marketId])
}

// Historical odds snapshots — used for admin "previous vs current" monitoring
// and to preserve the exact price a bet was placed against.
model OddsSnapshot {
  id        String   @id @default(cuid())
  outcomeId String
  price     Decimal  @db.Decimal(10, 3)
  point     Decimal? @db.Decimal(10, 2)
  capturedAt DateTime @default(now())

  outcome Outcome @relation(fields: [outcomeId], references: [id])

  @@index([outcomeId, capturedAt])
}

// ---------- Betting ----------

model Bet {
  id              String    @id @default(cuid())
  userId          String
  betType         BetType
  stake           Decimal   @db.Decimal(18, 2)
  combinedOdds    Decimal   @db.Decimal(12, 4)
  potentialReturn Decimal   @db.Decimal(18, 2)
  potentialProfit Decimal   @db.Decimal(18, 2)
  status          BetStatus @default(PENDING)
  idempotencyKey  String    @unique
  placedAt        DateTime  @default(now())
  settledAt       DateTime?

  user               User                @relation(fields: [userId], references: [id])
  selections          BetSelection[]
  walletTransactions   WalletTransaction[]

  @@index([userId])
  @@index([status])
}

model BetSelection {
  id               String          @id @default(cuid())
  betId            String
  eventId          String
  marketKey        String
  outcomeId        String
  bookmakerKey     String
  selectionName    String
  oddsAtPlacement  Decimal         @db.Decimal(10, 3)
  point            Decimal?        @db.Decimal(10, 2)
  eventStartTime   DateTime
  status           SelectionStatus @default(PENDING)

  bet     Bet     @relation(fields: [betId], references: [id])
  event   Event   @relation(fields: [eventId], references: [id])
  outcome Outcome @relation(fields: [outcomeId], references: [id])

  @@index([betId])
  @@index([eventId])
}

// ---------- Payments ----------

model Withdrawal {
  id             String           @id @default(cuid())
  userId         String
  amount         Decimal          @db.Decimal(18, 2)
  currency       String
  method         String
  status         WithdrawalStatus @default(PENDING)
  provider       String?
  providerRef    String?          @unique
  idempotencyKey String           @unique
  failureReason  String?
  createdAt      DateTime         @default(now())
  processedAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model PaymentTransaction {
  id             String             @id @default(cuid())
  userId         String
  type           String // "deposit" | "withdrawal"
  amount         Decimal            @db.Decimal(18, 2)
  currency       String
  status         TransactionStatus  @default(PENDING)
  provider       String
  providerRef    String?            @unique
  idempotencyKey String             @unique
  rawPayload     Json?
  createdAt      DateTime           @default(now())
  completedAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

// ---------- Promotions / RG / Compliance / UX ----------

model Promotion {
  id          String          @id @default(cuid())
  name        String
  description String
  terms       String
  startDate   DateTime
  endDate     DateTime
  status      PromotionStatus @default(DRAFT)
  createdAt   DateTime        @default(now())
}

model ResponsibleGamblingSetting {
  id               String    @id @default(cuid())
  userId           String    @unique
  depositLimit     Decimal?  @db.Decimal(18, 2)
  lossLimit        Decimal?  @db.Decimal(18, 2)
  sessionLimitMins Int?
  selfExclusionUntil DateTime?
  coolingOffUntil  DateTime?
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  eventId   String?
  sportKey  String?
  teamName  String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])

  @@index([userId])
}

// Every admin action and every automated financial mutation should write here.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorType  String // "admin" | "system" | "user"
  action     String
  targetType String?
  targetId   String?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
}
